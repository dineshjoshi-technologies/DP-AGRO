{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sensor Data Schema V1",
  "type": "object",
  "required": ["farm_id", "sensor_id", "timestamp_utc", "measurement", "quality_flag"],
  "properties": {
    "farm_id": {"type": "string"},
    "sensor_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "measurement": {"type": "object"},
    "quality_flag": {"type": "integer", "minimum": 0, "maximum": 1}
  }
}