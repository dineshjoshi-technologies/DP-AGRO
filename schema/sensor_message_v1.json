{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dpa-ai-agri.internal/schema/sensor_message_v1.json",
  "title": "Sensor Ingest Envelope V1 (Phase 1)",
  "description": "Cloud ingest envelope per AI Data Governance Policy v1.0 section 3.1. Mandatory fields: farm_id, sensor_id, timestamp_utc, measurement, quality_flag. Edge gateways emit this envelope over TLS 1.3; batch SHA-256 hashes are recorded to the blockchain audit trail (policy section 5).",
  "type": "object",
  "required": ["farm_id", "sensor_id", "timestamp_utc", "measurement", "quality_flag"],
  "additionalProperties": false,
  "properties": {
    "farm_id": {
      "type": "string",
      "pattern": "^FARM-[0-9]{3}$",
      "description": "Pilot farm identifier, must exist in ops/sensor_network/farm_registry.json"
    },
    "sensor_id": {
      "type": "string",
      "pattern": "^(SOIL|WX|SPEC)-[A-Z0-9-]+-[0-9]{2,3}(-alt)?$",
      "description": "Device identifier; prefix SOIL (moisture/EC/pH), WX (weather), SPEC (NDVI spectral)"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC reading time"
    },
    "measurement": {
      "type": "object",
      "description": "Typed measurement payload keyed by sensor type",
      "oneOf": [
        { "$ref": "#/definitions/soilMeasurement" },
        { "$ref": "#/definitions/weatherMeasurement" },
        { "$ref": "#/definitions/spectralMeasurement" }
      ]
    },
    "quality_flag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "0 = nominal, 1 = degraded (degraded readings are rejected at ingest per policy section 3.1)"
    }
  },
  "definitions": {
    "soilMeasurement": {
      "type": "object",
      "required": ["type", "moisture"],
      "properties": {
        "type": { "const": "soil" },
        "moisture": { "type": "number", "minimum": 0, "maximum": 1, "description": "volumetric water content m3/m3" },
        "ec": { "type": "number", "minimum": 0, "maximum": 10, "description": "electrical conductivity dS/m" },
        "ph": { "type": "number", "minimum": 3, "maximum": 11 },
        "unit": { "const": "m3/m3" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "weatherMeasurement": {
      "type": "object",
      "required": ["type", "temperature_c"],
      "properties": {
        "type": { "const": "weather" },
        "temperature_c": { "type": "number", "minimum": -20, "maximum": 60 },
        "humidity": { "type": "number", "minimum": 0, "maximum": 100, "description": "% RH" },
        "rainfall_mm": { "type": "number", "minimum": 0 },
        "pm2_5": { "type": "number", "minimum": 0 },
        "co2_ppm": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "spectralMeasurement": {
      "type": "object",
      "required": ["type", "ndvi"],
      "properties": {
        "type": { "const": "spectral" },
        "ndvi": { "type": "number", "minimum": -1, "maximum": 1 },
        "source": { "enum": ["edge", "satellite"] }
      },
      "additionalProperties": false
    }
  }
}